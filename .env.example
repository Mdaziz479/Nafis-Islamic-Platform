QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
# A long, random server-only secret used to sign login sessions.
AUTH_SECRET=
# MongoDB Atlas connection string. Never prefix this variable with NEXT_PUBLIC_.
MONGODB_URI="YOUR_MONGODB_ATLAS_CONNECTION_STRING"
# Public origin used for canonical URLs, sitemap, and robots metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
